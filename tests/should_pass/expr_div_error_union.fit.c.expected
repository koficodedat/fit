#include <stdio.h>
#include <string.h>
#include <stdlib.h>

typedef int Int;

typedef enum {
  OutOfRange_OutOfRange = 0
} OutOfRange;

typedef enum {
  DivByZero_DivByZero = 0
} DivByZero;

/* error union MathError = DivByZero | OutOfRange */
typedef struct {
  int tag;
  union {
    DivByZero DivByZero;
    OutOfRange OutOfRange;
  };
} MathError;

typedef struct {
  int tag;
  union { Int ok; MathError err; };
} R_Int_MathError;

typedef struct {
  int tag;
  union { Int ok; DivByZero err; };
} R_Int_DivByZero;


R_Int_MathError safe_div(Int a, Int b) {
  {
    Int _t0 = b;
    R_Int_DivByZero _t1;
    if (_t0 == 0) {
      _t1 = (R_Int_DivByZero){1, {.err = DivByZero_DivByZero}};
    } else {
      _t1 = (R_Int_DivByZero){0, {.ok = (a / _t0)}};
    }
    R_Int_DivByZero _t2 = _t1;
    if (_t2.tag != 0) {
      R_Int_MathError _err = {1, {.err = (MathError){0, {.DivByZero = _t2.err}}}};
      return _err;
    }
    Int q = _t2.ok;
    return (R_Int_MathError){0, {.ok = q}};
  }
}

