#include <stdio.h>
#include <string.h>
#include <stdlib.h>

typedef int Int;

typedef enum {
  DivByZero_DivByZero = 0
} DivByZero;

typedef struct {
  int tag;
  union { Int ok; DivByZero err; };
} R_Int_DivByZero;


R_Int_DivByZero div_mod_demo(Int a, Int b) {
  {
    Int _t0 = a;
    Int _t1 = b;
    R_Int_DivByZero _t2;
    if (_t1 == 0) {
      _t2 = (R_Int_DivByZero){1, {.err = DivByZero_DivByZero}};
    } else {
      _t2 = (R_Int_DivByZero){0, {.ok = (_t0 / _t1)}};
    }
    R_Int_DivByZero _t3 = _t2;
    if (_t3.tag != 0) {
      R_Int_DivByZero _err = {1, {.err = _t3.err}};
      return _err;
    }
    Int q = _t3.ok;
    {
      Int _t4 = a;
      Int _t5 = b;
      R_Int_DivByZero _t6;
      if (_t5 == 0) {
        _t6 = (R_Int_DivByZero){1, {.err = DivByZero_DivByZero}};
      } else {
        _t6 = (R_Int_DivByZero){0, {.ok = (_t4 % _t5)}};
      }
      R_Int_DivByZero _t7 = _t6;
      if (_t7.tag != 0) {
        R_Int_DivByZero _err = {1, {.err = _t7.err}};
        return _err;
      }
      Int r = _t7.ok;
      return (R_Int_DivByZero){0, {.ok = (q + r)}};
    }
  }
}

