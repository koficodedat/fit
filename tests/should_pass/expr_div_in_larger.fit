// (a / b)? + c — the composition the analysis round traced through emitExpr's shared
// `out` array (§1.3): the try-statements from unwrapping the division must be emitted
// before the addition, and they are, because `out` threads through by reference.
fn div_in_larger(a: Int, b: Int, c: Int) -> Result<Int, DivByZero> {
    Ok((a / b)? + c)
}
