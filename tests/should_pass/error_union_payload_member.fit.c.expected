#include <stdio.h>
#include <string.h>
#include <stdlib.h>

typedef int Int;
typedef int Chars;

typedef enum {
  IoError_NotFound = 0,
  IoError_Denied = 1
} IoError;

typedef struct {
  int tag;
  union {
    Chars Malformed;
  };
} ParseError;

/* error union ConfigError = IoError | ParseError */
typedef struct {
  int tag;
  union {
    IoError IoError;
    ParseError ParseError;
  };
} ConfigError;

typedef struct {
  int tag;
  union { Int ok; IoError err; };
} R_Int_IoError;

typedef struct {
  int tag;
  union { Int ok; ParseError err; };
} R_Int_ParseError;

typedef struct {
  int tag;
  union { Int ok; ConfigError err; };
} R_Int_ConfigError;

extern R_Int_IoError open_it(void);
extern R_Int_ParseError parse_it(void);
extern ParseError make_parse_error(void);

R_Int_ConfigError load(void) {
  {
    R_Int_IoError _t0 = open_it();
    if (_t0.tag != 0) {
      R_Int_ConfigError _err = {1, {.err = (ConfigError){0, {.IoError = _t0.err}}}};
      return _err;
    }
    Int a = _t0.ok;
    {
      R_Int_ParseError _t1 = parse_it();
      if (_t1.tag != 0) {
        R_Int_ConfigError _err = {1, {.err = (ConfigError){1, {.ParseError = _t1.err}}}};
        return _err;
      }
      Int b = _t1.ok;
      return (R_Int_ConfigError){1, {.err = (ConfigError){1, {.ParseError = make_parse_error()}}}};
    }
  }
}

