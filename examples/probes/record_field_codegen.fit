// PROBE — captures codegen behavior for aggregate field types.
// Both the record and resource emission loops in codegen.ts hardcode `int`
// for every field regardless of declared type.

resource Inner {
    fd:      Int,
    cleanup: close_inner,
}

record Wrapper {
    inner: Inner,
    count: Int,
}

resource Outer {
    inner: Inner,
    tag:   Int,
    cleanup: close_outer,
}

fn close_inner(i: move Inner) -> ()
fn close_outer(o: move Outer) -> ()
fn make_wrapper(i: move Inner) -> Wrapper
fn noop() -> ()
