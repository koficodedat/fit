// PROBE — DOCUMENTS A KNOWN UNSOUNDNESS. Currently accepted; should be rejected.
// Worse than a leak: because Holder is unrestricted, it carries no use-once
// obligation, so the same wrapped Conn can be handed out repeatedly.

resource Conn {
    fd:      Int,
    cleanup: close,
}

record Holder {
    c: Conn,
}

fn open() -> Conn
fn close(c: move Conn) -> ()
fn make_holder(c: move Conn) -> Holder
fn use_holder(h: Holder) -> ()

fn double_use() -> () {
    let c = open()
    let h = make_holder(c)
    use_holder(h)
    use_holder(h)
}
